# Copy to .env and adjust. Never commit .env.

# Which LLM backend /ask uses: "ollama" (local, default) or the hosted provider (added in Phase 3)
LLM_PROVIDER=ollama

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Where uploaded PDFs and the Chroma index are stored (relative to backend/)
DATA_DIR=data

# Per-file upload limit in megabytes, and max files per upload request
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10

# Local embedding model (downloaded from Hugging Face on first start, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking, in characters. Keep CHUNK_SIZE under ~1000: MiniLM truncates input after 256 tokens.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
