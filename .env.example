# Copy to .env and adjust. Never commit .env.

# Which LLM backend /ask uses: "ollama" (local, default) or "gemini" (hosted)
LLM_PROVIDER=ollama
# Max tokens the model may generate per answer (for Gemini this includes thinking tokens)
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Ollama (local): install from https://ollama.com, then `ollama pull <model>`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192

# Gemini (hosted): get a key at https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products: use public documents only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high, or empty for the model default. Check the model supports it.
GEMINI_THINKING_LEVEL=minimal

# Retrieval for /ask
ASK_TOP_K=5
# Cosine-similarity cutoff below which /ask refuses without calling the LLM.
# Empty = off. Tuned in Phase 6 with the eval set.
MIN_RELEVANCE_SCORE=
# Max /ask requests per client IP per minute (0 = unlimited)
ASK_RATE_LIMIT_PER_MINUTE=10

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded PDFs and the Chroma index are stored (relative to backend/)
DATA_DIR=data

# Per-file upload limit in megabytes, and max files per upload request
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10

# Local embedding model (downloaded from Hugging Face on first start, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking, in characters. Keep CHUNK_SIZE under ~1000: MiniLM truncates input after 256 tokens.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
